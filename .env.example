# Copy to `.env` for local testing (never commit .env).
# `npm run dev` reads it via the dev-only /api/contact route in vite.config.js.
# On Netlify, set these in: Project configuration → Environment variables.
# Only GMAIL_APP_PASSWORD needs to be marked as a secret there.
GMAIL_USER=sender-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
CONTACT_TO=inbox-that-receives-messages@gmail.com
